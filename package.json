{
  "name": "clipmunk",
  "version": "0.0.4",
  "description": "Cinematic 3D scenes and polished screen recordings from your live web app.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "clipmunk": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./studio": {
      "types": "./dist/types/studio/index.d.ts",
      "import": "./dist/studio.js"
    },
    "./recorder": {
      "types": "./dist/types/recorder/index.d.ts",
      "import": "./dist/recorder.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ARCHITECTURE.md"
  ],
  "sideEffects": [
    "./dist/cli.js"
  ],
  "scripts": {
    "dev": "vite examples/vite-app --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:browser": "vitest run tests/browser",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run lint && npm run lint:boundaries && npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "test:installed": "node scripts/check-installed.mjs",
    "test:export": "vitest run tests/export",
    "test:daemon": "vitest run tests/daemon",
    "test:recorder": "xvfb-run -a -s \"-screen 0 1600x1000x24\" vitest run tests/recorder",
    "test:take": "vitest run tests/take",
    "test:sequence": "vitest run tests/sequence",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "mediabunny": "^1.61.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaymalve/clipmunk.git"
  },
  "homepage": "https://clipmunk.dev",
  "bugs": {
    "url": "https://github.com/jaymalve/clipmunk/issues"
  },
  "keywords": [
    "video",
    "screen-recording",
    "react",
    "nextjs",
    "product-video",
    "sdk",
    "typescript"
  ]
}
