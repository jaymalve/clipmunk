{
  "version": 1,
  "id": "music-demo",
  "title": "Music demo",
  "description": "The dashboard assembles from separated depth while the camera drifts, scored with generated upbeat music timed to the motion.",
  "definition": {
    "width": 1400,
    "height": 980,
    "scene": {
      "camera": {
        "perspective": 1600,
        "rotateY": 22,
        "rotateX": 8,
        "z": 120
      },
      "focus": {
        "distance": 1480,
        "fStop": 2.8,
        "focalLength": 100,
        "maxBlur": 6
      },
      "nodes": [
        {
          "id": "page"
        },
        {
          "id": "sidebar",
          "parentId": "page"
        },
        {
          "id": "header",
          "parentId": "page"
        },
        {
          "id": "metrics",
          "parentId": "page"
        },
        {
          "id": "chart",
          "parentId": "page"
        },
        {
          "id": "customers",
          "parentId": "page"
        }
      ]
    },
    "motion": {
      "durationMs": 6000,
      "tracks": [
        {
          "target": {
            "kind": "camera"
          },
          "property": "x",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 180
            },
            {
              "timeMs": 6000,
              "value": -120
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "sidebar"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 520
            },
            {
              "timeMs": 2600,
              "value": 0
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "header"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 420
            },
            {
              "timeMs": 400,
              "value": 420
            },
            {
              "timeMs": 3000,
              "value": 0
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "metrics"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 340
            },
            {
              "timeMs": 800,
              "value": 340
            },
            {
              "timeMs": 3400,
              "value": 0
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "chart"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 260
            },
            {
              "timeMs": 1200,
              "value": 260
            },
            {
              "timeMs": 3800,
              "value": 0
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "customers"
          },
          "property": "z",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 200
            },
            {
              "timeMs": 1600,
              "value": 200
            },
            {
              "timeMs": 4200,
              "value": 0
            }
          ]
        },
        {
          "target": {
            "kind": "surface",
            "id": "customers"
          },
          "property": "opacity",
          "keyframes": [
            {
              "timeMs": 0,
              "value": 0
            },
            {
              "timeMs": 1600,
              "value": 0
            },
            {
              "timeMs": 3000,
              "value": 1
            }
          ]
        }
      ]
    }
  },
  "music": {
    "style": "upbeat"
  }
}
