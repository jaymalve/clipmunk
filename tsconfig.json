{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@flickjs/record": ["./src/index.ts"],
      "@flickjs/record/core": ["./src/core/index.ts"],
      "@flickjs/record/studio": ["./src/studio/index.ts"],
      "@flickjs/record/recorder": ["./src/recorder/index.ts"]
    }
  },
  "include": ["src", "examples", "tests", "scripts"]
}
